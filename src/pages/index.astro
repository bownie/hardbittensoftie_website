---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
---

<Layout>
  <Header />
  <main id="main-content" class="app-layout">
    <section class="space-y-8 border border-accent/20 bg-accent/5 p-8 shadow-[0_20px_40px_rgba(0,108,172,0.12)] sm:p-10">
      <div class="app-prose mx-auto max-w-prose space-y-6 text-base leading-8 text-muted-foreground">
        <h1 class="text-3xl font-semibold text-accent">Richard Bown</h1>



      </div>
    </section>
  </main>
  <Footer />
</Layout>
