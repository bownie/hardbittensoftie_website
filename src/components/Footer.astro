---
import type { HTMLAttributes } from "astro/types";
import { useTranslations } from "@/i18n";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const t = useTranslations(Astro.currentLocale);
const currentYear = new Date().getFullYear();
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="flex flex-col items-end gap-5 py-8 text-right text-sm text-muted-foreground sm:flex-row sm:items-end sm:justify-end"
  >
    <span>{t.footer.copyright} &#169; {currentYear} Richard W.Bown</span>
  </div>
</footer>
